# Required for Docker Compose
POSTGRES_DB=osau
POSTGRES_USER=osau
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
OSAU_ADMIN_EMAIL=operator@example.internal
OSAU_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# Optional: enables the default Upstage Solar provider.
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-open2

# Network and session safety defaults
OSAU_PORT=3000
OSAU_INTERNAL_NETWORK_MODE=false
OSAU_AUTH_DISABLED=false
OSAU_INTERNAL_PEER_ADDRESS_PRESERVED=false
OSAU_COOKIE_SECURE=true
OSAU_ALLOW_PRIVATE_NETWORKS=0
