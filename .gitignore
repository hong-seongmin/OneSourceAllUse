evidence/runs/
# Browser captures can contain source content. Keep explicitly curated evidence
# outside this generated directory when it must be reviewed or shared.
evidence/captures/
# Legacy capture outputs and archives are reproducible with
# `npm run capture:design-review`; keep review notes, not image binaries, in Git.
evidence/*.zip
evidence/design-review-*/screens/
evidence/design-review-*/data/
